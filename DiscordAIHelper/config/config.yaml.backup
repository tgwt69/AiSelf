advanced:
  conversation_memory: true
  message_caching: true
  multilingual_support: false
  response_caching: false
  sentiment_analysis: false
  topic_detection: false
  user_preferences: true
ai:
  content_filter: true
  context_window: 30
  groq_settings:
    frequency_penalty: 0.3
    max_tokens: 1536
    presence_penalty: 0.1
    top_p: 0.95
  max_response_length: 2000
  openai_settings:
    frequency_penalty: 0.3
    max_tokens: 1536
    presence_penalty: 0.1
    top_p: 0.95
  profanity_filter: false
  temperature: 0.8
bot:
  allow_dm: true
  allow_gc: true
  anti_age_ban: true
  auto_conversation: false
  auto_conversation_chance: 0.08
  auto_conversation_interval: 600
  auto_conversation_max_per_hour: 3
  batch_messages: true
  batch_wait_time: 5.0
  conversation_timeout: 400
  cooldown_duration: 45
  disable_mentions: true
  groq_model: llama-3.3-70b-versatile
  help_command_enabled: true
  hold_conversation: true
  max_messages_per_minute: 8
  openai_model: gpt-4o
  owner_id: 1007652090925043700
  prefix: '~'
  realistic_typing: true
  reply_ping: false
  trigger: everyone
notifications:
  error_notifications: true
  error_webhook: ''
  ratelimit_notifications: true
  startup_notifications: false
security:
  adaptive_cooldowns: true
  detailed_logging: true
  error_tracking: true
  message_variation: true
  random_delays: true
  smart_batching: true
  typing_variation: true
