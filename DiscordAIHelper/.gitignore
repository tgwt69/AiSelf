# Discord AI Selfbot - 2025 Edition
# Enhanced .gitignore for security and best practices

# ============================================
# Sensitive Configuration Files (CRITICAL)
# ============================================
config/.env
.env
*.env
.env.local
.env.production
.env.development

# Discord tokens and API keys
token.txt
discord_token
api_keys.txt
secrets.json
credentials.json

# ============================================
# Database and Data Files
# ============================================
data/
*.db
*.sqlite
*.sqlite3
selfbot.db
database.db

# Database backups
*.db.backup
*.sql
*.dump

# ============================================
# Logs and Error Files
# ============================================
logs/
*.log
error.log
selfbot.log
debug.log
discord.log
*.log.*

# Error dumps
crash_reports/
error_dumps/
*.crash
*.dump

# ============================================
# Python Environment and Cache
# ============================================
# Virtual environments
bot-env/
venv/
env/
ENV/
.venv/
.ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

